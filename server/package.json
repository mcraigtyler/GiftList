{
  "name": "giftlist-server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run build:tsoa && nodemon",
    "build": "npm run build:tsoa && tsc",
    "build:tsoa": "tsoa spec-and-routes",
    "lint": "eslint src --ext .ts",
    "test": "vitest --passWithNoTests",
    "test:run": "vitest run --passWithNoTests",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/lib/dataSource.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/lib/dataSource.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/lib/dataSource.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "open-graph-scraper": "^6.3.3",
    "pg": "^8.11.3",
    "reflect-metadata": "^0.2.1",
    "tsoa": "^6.1.1",
    "typeorm": "^0.3.19",
    "uuidv7": "^0.6.3"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.11.5",
    "eslint": "^8.56.0",
    "nodemon": "^3.0.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  }
}
