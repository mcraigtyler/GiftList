# ── PostgreSQL (read by both the server AND docker-compose) ──────────────────
POSTGRES_USER=admin
POSTGRES_PASSWORD=really-good-password
POSTGRES_DB=giftlist
POSTGRES_PORT=5432

# Constructed from the vars above — update if you change the values
DATABASE_URL=postgresql://admin:really-good-password@localhost:5432/giftlist

# ── Server ───────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-output-of--openssl-rand-hex-32
NODE_ENV=development
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
TYPEORM_SYNCHRONIZE=false
